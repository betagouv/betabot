# OpenAI-compatible API (e.g. Ollama, vLLM, LM Studio…)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:14b
OPENAI_EMBED_MODEL=nomic-embed-text
EMBED_DIMS=768

# Data directory
DATA_DIR=./data

# Channels Tchap to surface as direct links in answers — path to a JSON file
# [{ "url", "name", "description" }]. Use an empty array [] for development.
TCHAP_CHANNELS=./data/tchap-channels.json

# Public calendar ICS URL (used by get-data.sh and system prompt)
CALENDAR_ICS_URL=

# WelcomeKit job offers (optional — used by fetch-wttj.ts)
WELCOMEKIT_TOKEN=

# Choisir le service public job offers (optional — used by fetch-choisirleservicepublic.ts)
# Comma-separated list of Rss_Entity ids, e.g. "1,2,3"
# https://place-ep-recrute.talent-soft.com//offre-de-emploi/tous-les-flux-rss.aspx
CHOISIRLESERVICEPUBLIC_IDS=

# n8n webhook receiving user feedback (query + feedback + full conversation)
FEEDBACK_WEBHOOK_URL=

# Matrix (v1)
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER=@betabot:example.org
MATRIX_ACCESS_TOKEN=syt_...
# MATRIX_PASSWORD=...   # alternative to access token
